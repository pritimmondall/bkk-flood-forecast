# ─── Bangkok Flood Forecast — what NOT to commit ────────────────────────────
# Rule: push code, docs, and small model artifacts. Never push raw/large data.
# GitHub rejects files >100 MB; the data is regenerable from the pipeline.

# ── Large data (GBs) — regenerate with data_pipeline/ ──
data/training/*.parquet
data/training/*.csv
data/parquet/**/*.parquet
data/*.csv.gz

# keep the small, hand-built data files (force-tracked below)
!data/station_registry_full.csv
!data/parquet/quality_scorecard.csv

# ── GIS rasters & boundaries (100s of MB, some >100 MB) ──
data/*.tif
data/viz/
data/*.tar.gz
data/*.gdb/
data/*.shp/
*.tif
*.tar.gz

# ── Python ──
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ── Caches & scratch ──
data_pipeline/.osm_cache.json
data/training/Untitled-*.ipynb
data/training/val_sample.csv

# ── OS / editor ──
.DS_Store
*~
.vscode/
.idea/

# ── Secrets (never commit) ──
*.env
.env
*.key
