# ─── Bangkok Flood Forecast v3.0 — what NOT to commit ──────────────────────
# Rule: commit code, configuration, docs and small artefacts.
# Never commit raw or derived data — it is large and it is regenerable by
# running notebooks 00 → 02.

# ── Raw sensor archive (54.8 GB, supplied by BMA) ──
data/Rain_2019-*/
data/Water_2019-*/
data/Flow_2019-*/
data/Flood_2019-*/

# ── Derived data (rebuild with the notebooks) ──
data/interim/
data/features/
data/external/
data/parquet/
data/training/
*.parquet

# ── GIS rasters (13.9 GB DTM; several files exceed GitHub's 100 MB limit) ──
data/DTM_1M/
data/viz/
data/tha_admin_boundaries.gdb/
data/tha_admin_boundaries.shp/
*.tif
*.tif.ovr
*.tar.gz
*.shp
*.shx
*.dbf
*.prj
*.cpg

# ── Small, hand-built or contract files that everything depends on: KEEP ──
!data/gis/*.geojson
!data/gis/*.csv
!data/station_registry_full.csv
!docs/reports/**/*.csv
!docs/reports/**/*.json

# ── Models ──
models/*.pkl
models/*.pt
models/*.txt
!models/metadata.json

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.coverage

# ── Node / frontend ──
node_modules/
frontend/dist/
frontend/.vite/

# ── Local environment ──
.env
.env.*
!.env.example

# ── OS ──
.DS_Store
Thumbs.db

# ── Scratch ──
scratch/
tmp/
*.log

# Live collector history. This is DATA, and it is append-only and
# irreplaceable — none of the source APIs publish a downloadable past.
# Back it up separately; losing it means losing time, not just bytes.
data/live/
